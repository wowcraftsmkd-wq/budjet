[
 {
  "id": "l1",
  "text": "ഒരു ഗ്ലാസ് ചായക്ക് എത്ര രൂപയാ?",
  "t0": 0.3,
  "t1": 4.9
 },
 {
  "id": "l2",
  "text": "പത്തോ? പതിനഞ്ചോ?",
  "t0": 1.3,
  "t1": 4.9
 },
 {
  "id": "l3a",
  "text": "പക്ഷേ അതിന്റെ കൂടെ കിട്ടുന്നതിന്…",
  "t0": 5.3,
  "t1": 9.95
 },
 {
  "id": "l3b",
  "text": "വിലയിടാൻ പറ്റില്ല.",
  "t0": 6.3,
  "t1": 9.95
 },
 {
  "id": "l4a",
  "text": "മഴ കനക്കുമ്പോൾ, ഓലപ്പുരയുടെ താഴെ നിന്ന്",
  "t0": 10.6,
  "t1": 16.6
 },
 {
  "id": "l4b",
  "text": "ഊതിയൂതി കുടിക്കുന്ന ഒരു ചൂട് ചായ.",
  "t0": 12.4,
  "t1": 16.6
 },
 {
  "id": "l5",
  "text": "ചേട്ടൻ നീട്ടിയടിക്കുമ്പോൾ പൊങ്ങുന്ന ആ പത…",
  "t0": 17.1,
  "t1": 21.6
 },
 {
  "id": "l6a",
  "text": "ചില്ലലമാരയിലെ പഴംപൊരി.",
  "t0": 22,
  "t1": 26.6
 },
 {
  "id": "l6b",
  "text": "ആദ്യം കണ്ണുകൊണ്ടാ കഴിക്കുന്നത്.",
  "t0": 22.6,
  "t1": 26.6
 },
 {
  "id": "l7a",
  "text": "റേഡിയോയിൽ ഒരു പഴയ പാട്ട്, ബെഞ്ചിൽ ഒരു പത്രം,",
  "t0": 27,
  "t1": 32.45
 },
 {
  "id": "l7b",
  "text": "ചുറ്റും കുറെ നാട്ടുവർത്തമാനം.",
  "t0": 28.4,
  "t1": 32.45
 },
 {
  "id": "l8a",
  "text": "ആദ്യ ശമ്പളം കിട്ടിയ ദിവസവും,",
  "t0": 33,
  "t1": 37.95
 },
 {
  "id": "l8b",
  "text": "എല്ലാം കൈവിട്ടുപോയ രാത്രിയും…",
  "t0": 34,
  "t1": 37.95
 },
 {
  "id": "l9",
  "text": "കൂട്ടുകാരുടെ കൂടെ ഒരു ചായ മതിയായിരുന്നു.",
  "t0": 38,
  "t1": 42.45
 },
 {
  "id": "l10a",
  "text": "അതുകൊണ്ടാ നമ്മൾ ചായ കുടിക്കാൻ പോകുന്നത്.",
  "t0": 42.9,
  "t1": 48.2
 },
 {
  "id": "l10b",
  "text": "ചായക്ക് വേണ്ടി മാത്രമല്ല…",
  "t0": 44.3,
  "t1": 48.2
 },
 {
  "id": "l11",
  "text": "ആ വൈബിന് വേണ്ടി.",
  "t0": 48.333,
  "t1": 51.3
 },
 {
  "id": "c1",
  "text": "നിന്റെ ചായ സ്പോട്ട് ഏതാ?",
  "t0": 51.2,
  "t1": 57.5
 },
 {
  "id": "c2",
  "text": "കമന്റ് ചെയ്യ്, കൂടെ വരുന്ന ആളെ ടാഗ് ചെയ്യ്.",
  "t0": 52.3,
  "t1": 57.5
 }
]